# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for JSON, packs, vectors, code, markdown
*.json text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.db binary
*.sqlite binary
*.zip binary
